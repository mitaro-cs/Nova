{
  "name": "fsfy-web",
  "private": true,
  "version": "2.1.6-beta",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build:tv": "svelte-kit sync && vite build -c vite.tv.config.ts",
    "build": "npm run build:tv && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tv/tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.59.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "dashjs": "5.3.0",
    "hls.js": "^1.7.4"
  }
}
